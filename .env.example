# ══════════════════════════════════════════════════════════════
# MODO DE OPERACIÓN
#   dry_run → precios reales, órdenes simuladas en memoria (por defecto)
#   demo    → Bitget Demo Trading (fondos ficticios, exchange real)
#   live    → dinero real; exige además CONFIRM_LIVE_TRADING=yes
# ══════════════════════════════════════════════════════════════
TRADING_MODE=dry_run
CONFIRM_LIVE_TRADING=
# true si tus cuentas están migradas a Unified Trading Account (API v3)
BITGET_UTA=false

# SUB3 desactivada por defecto (requiere copy trading nativo configurado en la web).
# SUB10 (pairs trading) y SUB11 (SuperTrend) también: añadirlas tras backtestearlas.
# SUB4 y SUB7 desactivadas por defecto tras el test de estrés de 3 años (perdían en todos los escenarios).
ENABLED_STRATEGIES=SUB1,SUB2,SUB5,SUB6,SUB8,SUB9

# ══════════════════════════════════════════════════════════════
# BITGET — una API key por subcuenta (permisos: lectura + trading,
# SIN retiros, con lista blanca de IP). Formato BITGET_<CUENTA>_*
# ══════════════════════════════════════════════════════════════
BITGET_MAIN_API_KEY=
BITGET_MAIN_SECRET=
BITGET_MAIN_PASSPHRASE=
BITGET_SUB1_API_KEY=
BITGET_SUB1_SECRET=
BITGET_SUB1_PASSPHRASE=
BITGET_SUB2_API_KEY=
BITGET_SUB2_SECRET=
BITGET_SUB2_PASSPHRASE=
BITGET_SUB3_API_KEY=
BITGET_SUB3_SECRET=
BITGET_SUB3_PASSPHRASE=
BITGET_SUB4_API_KEY=
BITGET_SUB4_SECRET=
BITGET_SUB4_PASSPHRASE=
BITGET_SUB5_API_KEY=
BITGET_SUB5_SECRET=
BITGET_SUB5_PASSPHRASE=
BITGET_SUB6_API_KEY=
BITGET_SUB6_SECRET=
BITGET_SUB6_PASSPHRASE=
BITGET_SUB7_API_KEY=
BITGET_SUB7_SECRET=
BITGET_SUB7_PASSPHRASE=
BITGET_SUB8_API_KEY=
BITGET_SUB8_SECRET=
BITGET_SUB8_PASSPHRASE=
BITGET_SUB9_API_KEY=
BITGET_SUB9_SECRET=
BITGET_SUB9_PASSPHRASE=
# Nuevas (desactivadas por defecto: validarlas antes con kriptty-backtest)
BITGET_SUB10_API_KEY=
BITGET_SUB10_SECRET=
BITGET_SUB10_PASSPHRASE=
BITGET_SUB11_API_KEY=
BITGET_SUB11_SECRET=
BITGET_SUB11_PASSPHRASE=

# ══════════════════════════════════════════════════════════════
# RIESGO GLOBAL
# ══════════════════════════════════════════════════════════════
MAX_DAILY_LOSS_PCT=0.05
MAX_SL_DISTANCE_PCT=0.25
DEFAULT_LEVERAGE=3
# Corte por drawdown desde máximos (oct. 2026): sin aperturas durante N días si la subcuenta
# (spot + futuros) cae más de este %. SUB8 (DCA) queda fuera por diseño.
MAX_DRAWDOWN_PCT=0.25
# Parada dura desde el máximo histórico (no se reinicia): requiere revisión manual.
MAX_TOTAL_DRAWDOWN_PCT=0.40
# Margen máximo en futuros por subcuenta (fracción del equity). 0.20 = no usar más del 20%
# de cada cuenta: con 7x la exposición máxima es 1.4× el equity. 1.0 = sin límite.
MAX_MARGIN_PCT=1.0
# Rampa: el límite anterior se alcanza por escalones (uno más cada RAMP_STEP_DAYS si la subcuenta
# gana; uno menos si cae más de RAMP_STEP_BACK_PCT). Con 1 M$ y 0.2: 50k → 100k → 150k → 200k.
CAPITAL_RAMP=
RAMP_STEP_DAYS=30
RAMP_STEP_BACK_PCT=0.05
# Apalancamiento por subcuenta (escala también el riesgo por operación), p. ej. SUB6=3,SUB9=3,SUB10=3
LEVERAGE=
# Duración máxima de una posición de futuros en horas (0 = sin límite) y subcuentas exentas.
MAX_HOLD_HOURS=0
MAX_HOLD_EXEMPT=SUB6,SUB8,SUB9
# Modo por subcuenta (nunca más real que TRADING_MODE): las subcuentas en demo usan sus claves de
# Bitget Demo Trading. Ej.: SUB1=demo,SUB4=demo,SUB7=demo
ACCOUNT_MODES=
# Límite de capital por subcuenta (sustituye a MAX_MARGIN_PCT en esa subcuenta). Ej.: SUB2=0.1,SUB11=0.1
MAX_MARGIN_BY_ACCOUNT=
# Graduación de demo a dinero real: días mínimos en demo, en beneficio y drawdown máximo. El bot
# solo lo avisa (registro, MCP y `kriptty-engine --status`); el cambio de modo lo hace una persona.
GRADUATION_DAYS=90
GRADUATION_MAX_DD=0.10
# Propuesta (estrategia/estrategia.html, pestaña «Mi estrategia»): 11 subcuentas de 1 M$, un agente
# en cada una; 5 con dinero real desde el día 1 y 5 en demo hasta graduarse; SUB3 en espera.
#   TRADING_MODE=live  CONFIRM_LIVE_TRADING=yes
#   ENABLED_STRATEGIES=SUB1,SUB2,SUB4,SUB5,SUB6,SUB7,SUB8,SUB9,SUB10,SUB11
#   ACCOUNT_MODES=SUB1=demo,SUB2=demo,SUB4=demo,SUB7=demo,SUB11=demo
#   MAX_MARGIN_PCT=0.2  MAX_MARGIN_BY_ACCOUNT=SUB1=0.1,SUB2=0.1,SUB4=0.1,SUB7=0.1,SUB11=0.1
#   CAPITAL_RAMP=0.25,0.5,0.75,1  LEVERAGE=SUB6=3,SUB9=3,SUB10=3
#   MAX_DRAWDOWN_PCT=0.10  MAX_TOTAL_DRAWDOWN_PCT=0.20  MAX_HOLD_HOURS=48
DRAWDOWN_COOLDOWN_DAYS=14
DRAWDOWN_EXEMPT=SUB8
# Activos base que nunca entran en los universos de SUB2/SUB6 (además de acciones/metales/índices).
EXCLUDED_BASES=
# Aviso al arrancar si el reloj local se desvía de Bitget más de esto (ms).
MAX_CLOCK_OFFSET_MS=1000
DRY_RUN_EQUITY=10000

# ══════════════════════════════════════════════════════════════
# DATOS EXTERNOS (todos opcionales)
# ══════════════════════════════════════════════════════════════
# FRED funciona sin clave (CSV público); con clave usa la API oficial.
FRED_API_KEY=
# CryptoPanic ya no tiene plan gratuito; plan: developer | growth | enterprise
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_PLAN=developer
NEWSDATA_API_KEY=
# FinBERT requiere: pip install "kriptty[finbert]" (≈2 GB); si no, VADER
USE_FINBERT=false

# SUB3: IDs de los traders que sigues en Bitget (informativo, para logs)
SUB3_TRADER_IDS=

# ══════════════════════════════════════════════════════════════
# SISTEMA
# ══════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
STATE_PATH=data/state.db
MCP_READ_ONLY=true
MCP_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
# SDK MCP 2.2: HTTP sin estado (las sesiones con estado caducan a los 30 min sin actividad).
MCP_STATELESS_HTTP=true
